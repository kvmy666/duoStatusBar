<?xml version="1.0" encoding="utf-8"?>
<!--
  The Rive scene is read at runtime by the module inside System UI, not through the R class at a call
  site the shrinker can see. Without this, `shrinkResources` removes/renames `res/raw/duo.riv` and the
  element silently falls back to Canvas. The loader also resolves it through the module's resource
  table (which survives renaming), so this is belt-and-braces.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@raw/duo" />
