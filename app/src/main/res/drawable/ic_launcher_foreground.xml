<?xml version="1.0" encoding="utf-8"?>
<!--
  Duo launcher icon, foreground layer.
  Drawn in the Duo design space (120 x 120, see docs/DESIGN-duo.md) and scaled into the
  adaptive-icon safe area, so the icon and the on-screen status-bar element stay identical:
    ring  r 51.5 @ (59.5, 61.5), stroke 8, top gap reserved for the percentage
    Wi-Fi  arcs r 31 / 18.5 + centre dot
    cells  four spheres r 5.5 on the ring's curvature
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="13.54"
        android:translateY="12.18"
        android:scaleX="0.68"
        android:scaleY="0.68">

        <!-- battery ring: left half (bottom-left endpoint up to the top gap) -->
        <path
            android:pathData="M29.48,19.65 A51.5,51.5 0 0 0 15.52,88.28"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- battery ring: right half (top gap down to the bottom-right endpoint) -->
        <path
            android:pathData="M89.52,19.65 A51.5,51.5 0 0 1 103.48,88.28"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Wi-Fi layer 1 -->
        <path
            android:pathData="M33.21,62.08 A31,31 0 0 1 85.79,62.08"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round" />

        <!-- Wi-Fi layer 2 -->
        <path
            android:pathData="M43.81,68.70 A18.5,18.5 0 0 1 75.19,68.70"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round" />

        <!-- Wi-Fi dot -->
        <path
            android:pathData="M54.00,72.00 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
            android:fillColor="#FFFFFFFF" />

        <!-- cellular spheres -->
        <path
            android:pathData="M27.50,104.20 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
            android:fillColor="#FFFFFFFF" />
        <path
            android:pathData="M45.00,111.20 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
            android:fillColor="#FFFFFFFF" />
        <path
            android:pathData="M63.00,111.70 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
            android:fillColor="#FFFFFFFF" />
        <path
            android:pathData="M80.50,105.80 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
