<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Update checks: fetch the latest release (via the relay), post the update notification, download
         the APK (foreground service, Android 14 dataSync type), and hand it to the system installer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The provider-independent app <-> System UI channel. The module registers its receiver with this
         signature permission, so only this app can push settings; the app holds it too. -->
    <permission
        android:name="io.github.kvmy666.duostatusbar.permission.SETTINGS"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.kvmy666.duostatusbar.permission.SETTINGS" />

    <application
        android:name=".DuoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DuoStatusBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============ app <-> module channel ============ -->
        <!-- The app owns the user's settings; the module inside System UI reads them here.
             Exported without a permission on purpose: System UI is a different uid and holds no
             signature permission of ours, so requiring one would make the channel unusable. What it
             exposes is non-sensitive (on/off, renderer, size, offset). See settings/DuoPrefs.kt. -->
        <provider
            android:name=".settings.DuoSettingsProvider"
            android:authorities="io.github.kvmy666.duostatusbar.settings"
            android:exported="true"
            android:enabled="true" />

        <!-- Diagnostics as a file (FR-28): a bug report needs the whole log, not a shared string that
             chat apps truncate. Not exported, and only the diagnostics directory is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.github.kvmy666.duostatusbar.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The provider-independent settings channel (see SettingsBridge): System UI asks for the
             settings, and reports its status back. Exported so the System UI uid can reach them. -->
        <receiver
            android:name=".settings.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".settings.SettingsRequestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.kvmy666.duostatusbar.action.SETTINGS_REQUEST" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".settings.StatusBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.kvmy666.duostatusbar.action.STATUS_PUSH" />
                <action android:name="io.github.kvmy666.duostatusbar.action.DUMP_PUSH" />
                <action android:name="io.github.kvmy666.duostatusbar.action.FALLBACK_PUSH" />
                <action android:name="io.github.kvmy666.duostatusbar.action.STOCK_ICONS_PUSH" />
            </intent-filter>
        </receiver>

        <!-- The update notification's Download action bridges here to the download worker. Not exported:
             only this app's own PendingIntent targets it. -->
        <receiver
            android:name=".settings.UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.kvmy666.duostatusbar.DOWNLOAD_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- The download runs in WorkManager's foreground service; on Android 14+ it must declare the
             dataSync type or the system kills it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- ============ Shizuku (issue #4) ============ -->
        <!-- Optional. Only used to write the secure `icon_blacklist` setting so the stock Wi-Fi,
             cellular and battery icons can be hidden when the LSPosed view-hiding leaves them behind.
             The authority must be `<applicationId>.shizuku`; the permission keeps other apps out.
             Nothing here is required for the LSPosed path, which is unchanged. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- ============ Xposed / LSPosed module declaration ============ -->
        <!-- xposedmodule marks this APK as a module; without it LSPosed ignores us. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="Duo Status Bar — replaces the system battery, Wi-Fi and signal icons with Apple's combined 'Duo' element, animated with Rive. Tested on OnePlus 15 / OxygenOS 16 (Android 16)." />

        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- LSPosed scope: only SystemUI is hooked. The `android` scope is deliberately NOT
             included (see docs/dependencies.md — hooking system_server is what breaks
             screenshots and stability in sibling modules). -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <meta-data
            android:name="io.github.kvmy666.duostatusbar.DOWNLOAD_PROGRESS"
            android:value="true" />    
    </application>

</manifest>
