<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".DuoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DuoStatusBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============ Xposed / LSPosed module declaration ============ -->
        <!-- xposedmodule marks this APK as a module; without it LSPosed ignores us. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="Duo Status Bar — replaces the system battery, Wi-Fi and signal icons with Apple's combined 'Duo' element, animated with Rive. Tested on OnePlus 15 / OxygenOS 16 (Android 16)." />

        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- LSPosed scope: only SystemUI is hooked. The `android` scope is deliberately NOT
             included (see docs/dependencies.md — hooking system_server is what breaks
             screenshots and stability in sibling modules). -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
