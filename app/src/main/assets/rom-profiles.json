{
  "version": 2,
  "_comment": "Measured and static ROM maps. Only entries with \"measured\": true (or a shade map with \"shadeMeasured\": true) may override the built-in RomDetection defaults; unmeasured entries are documentation/test fixtures and must stay UNVERIFIED. Never mark a map measured without a device dump.",
  "profiles": [
    {
      "id": "oxygenos",
      "label": "OxygenOS / OnePlus",
      "systemUiPackage": "com.android.systemui",
      "containerIds": [
        "system_icons",
        "system_icons_container",
        "status_bar_end_side_content"
      ],
      "batteryId": "battery",
      "clockId": "clock",
      "match": [
        "oneplus",
        "oxygen"
      ],
      "measured": true,
      "notes": "measured on OxygenOS 16 (CPH2747): system_icons -> LinearLayout, battery 83x61 px",
      "shadeContainerIds": [
        "quick_qs_status_icons",
        "shade_header_system_icons"
      ],
      "shadeBatteryId": "batteryRemainingIcon",
      "shadeMeasured": true,
      "coverHook": true,
      "panelExpansionKind": "panel_type_5arg",
      "panelHookMeasured": true,
      "panelOwnerAvailable": true
    },
    {
      "id": "hyperos",
      "label": "HyperOS / MIUI",
      "systemUiPackage": "com.android.systemui",
      "containerIds": [
        "system_icons",
        "system_icon_area",
        "status_bar_icons",
        "statusIcons",
        "system_icons_container"
      ],
      "batteryId": "battery",
      "clockId": "clock",
      "match": [
        "xiaomi",
        "redmi",
        "poco"
      ],
      "measured": true,
      "notes": "measured on HyperOS 3 (24129PN74G, Android 17): system_icons -> MiuiStatusBatteryContainer holding statusIcons + battery; system_icon_area is the parent",
      "coverHook": true,
      "panelExpansionKind": "fzz_3arg",
      "panelHookMeasured": false
    },
