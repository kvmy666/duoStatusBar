    <!-- Font for the digits. Montserrat (OFL) ships with the Rive CLI samples; the final build will
         bundle a rounded face so the numbers match Apple's, with a "use system font" option. -->
    <FontAsset file="SysSans.ttf" name="SysSans" id="0:40" />

    <!-- ============================== data model ==============================
         The host application (inside SystemUI) sets these; the binds above push them into the
         drawing. All geometry maths lives in Kotlin so it can be unit-tested, which is why the
         ring exposes ready-made trim ends instead of a battery percentage.               -->

    <ViewModel defaultInstanceId="0:61" name="DuoModel" id="0:60">
        <ViewModelPropertyNumber name="trimLeftEnd" id="0:62" />
        <ViewModelPropertyNumber name="trimRightEnd" id="0:63" />
        <ViewModelPropertyNumber name="trackOpacity" id="0:64" />
        <ViewModelPropertyNumber name="percentOpacity" id="0:65" />
        <ViewModelPropertyNumber name="boltOpacity" id="0:66" />
        <ViewModelPropertyNumber name="wifiOuterOpacity" id="0:67" />
        <ViewModelPropertyNumber name="wifiMidOpacity" id="0:68" />
        <ViewModelPropertyNumber name="wifiDotOpacity" id="0:69" />
        <ViewModelPropertyNumber name="cell1Opacity" id="0:71" />
        <ViewModelPropertyNumber name="cell2Opacity" id="0:72" />
        <ViewModelPropertyNumber name="cell3Opacity" id="0:73" />
        <ViewModelPropertyNumber name="cell4Opacity" id="0:74" />
        <ViewModelPropertyNumber name="airplaneOpacity" id="0:75" />
        <ViewModelPropertyColor name="tint" id="0:81" />
        <ViewModelPropertyColor name="fgColor" id="0:82" />
        <ViewModelPropertyString name="percentText" id="0:83" />
        <ViewModelPropertyNumber name="percentFontSize" id="0:84" />
        <!-- Which occupant the middle slot holds: 0 off, 1 Wi-Fi, 2 airplane, 3 DND. One number rather
             than a boolean per occupant, because the slot holds exactly one thing at a time - and a
             transition can compare a number (`BindablePropertyNumber` + `TransitionValueNumberComparator`),
             which keeps the state machine a star instead of a mesh. -->
        <ViewModelPropertyNumber name="middleMode" id="0:107" />
        <!-- The arrival: 0 is "nothing asked for"; 500/750/1000/1250/1500 fires an arrival of that
             many milliseconds. One number carries both the trigger and the duration on purpose - it
             needs one transition condition, and the host cannot fire without also saying how long. -->
        <ViewModelPropertyNumber name="revealMs" id="0:105" />
        <!-- Departure: false shrinks the element away (lock / screen off), true brings it back. -->
        <ViewModelPropertyBoolean name="visible" id="0:106" />
        <!-- Charging: drives the bolt's journey from the middle slot to the ring's gap. -->
        <ViewModelPropertyBoolean name="charging" id="0:108" />
        <!-- The two signal axes the blend layers read: 0-3 arcs, 0-4 spheres. -->
        <ViewModelPropertyNumber name="wifiLevel" id="0:150" />
        <ViewModelPropertyNumber name="cellLevel" id="0:151" />
        <ViewModelPropertyNumber name="dndOpacity" id="0:87" />
        <!-- Each half's track arc length, so the ring can close (percentage off) or narrow (charging):
             the left grows to the whole drawn arc and the right shrinks to nothing. -->
        <ViewModelPropertyNumber name="leftArc" id="0:88" />
        <ViewModelPropertyNumber name="rightArc" id="0:89" />

        <ViewModelInstance exports="true" name="Default" id="0:61">
            <ViewModelInstanceNumber viewModelPropertyId="0:62" propertyValue="0.9010" />
            <ViewModelInstanceNumber viewModelPropertyId="0:63" propertyValue="0.3369" />
            <ViewModelInstanceNumber viewModelPropertyId="0:64" propertyValue="0.22" />
            <ViewModelInstanceNumber viewModelPropertyId="0:65" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:66" propertyValue="0" />
            <ViewModelInstanceNumber viewModelPropertyId="0:67" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:68" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:69" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:71" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:72" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:73" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:74" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:75" propertyValue="0" />
            <ViewModelInstanceColor viewModelPropertyId="0:81" propertyValue="FFFFFFFF" />
            <ViewModelInstanceColor viewModelPropertyId="0:82" propertyValue="FFFFFFFF" />
            <ViewModelInstanceString viewModelPropertyId="0:83" propertyValue="100" />
            <ViewModelInstanceNumber viewModelPropertyId="0:84" propertyValue="26" />
            <ViewModelInstanceNumber viewModelPropertyId="0:107" propertyValue="1" />
            <ViewModelInstanceNumber viewModelPropertyId="0:105" propertyValue="0" />
            <ViewModelInstanceBoolean viewModelPropertyId="0:106" propertyValue="true" />
            <ViewModelInstanceBoolean viewModelPropertyId="0:108" propertyValue="false" />
            <ViewModelInstanceNumber viewModelPropertyId="0:150" propertyValue="3" />
            <ViewModelInstanceNumber viewModelPropertyId="0:151" propertyValue="4" />
            <ViewModelInstanceNumber viewModelPropertyId="0:87" propertyValue="0" />
            <ViewModelInstanceNumber viewModelPropertyId="0:88" propertyValue="0.2379" />
            <ViewModelInstanceNumber viewModelPropertyId="0:89" propertyValue="0.2379" />
        </ViewModelInstance>
    </ViewModel>

