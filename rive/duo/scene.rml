            <Shape name="ringFillL" id="0:12">
                <Ellipse width="103" height="103" originX="0.5" originY="0.5" name="Path" />
                <Stroke thickness="8" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="Color">
