        <!-- =========================== state machine ===========================
             Inside the artboard, not beside it: an artboard only runs a machine declared as its
             child, and data binds only apply while a machine is running. The Reveal animation owns
             exactly the properties that are NOT bound (the group's scale), so animation and data
             binding never fight over the same value.                                    -->

        <StateMachine name="Duo" id="0:90">
            <!-- Inputs are view model booleans rather than StateMachineBool/Trigger on purpose: the
                 runtime's state-machine input setters are Kotlin `internal` (only
                 `SMIBoolean.setValue$kotlin_release` exists), so a host application cannot drive
                 them. Drawn from the view model, every input is reachable through the public
                 ViewModelInstance API. -->

            <!-- Layer 1 owns the reveal: scale bounce, one shot, re-fired through `revealRequest`.
                 Opacity and colour are deliberately NOT keyed here — they belong to the data binds,
                 so the two mechanisms never fight over the same property. -->
            <!-- Body: the only layer that touches the shared group node, so the whole element moves as
                 one object and can never de-sync.

                 The five Reveal states play ONE timeline at five speeds rather than five timelines, so
                 the arrival has a single shape to tune. `revealMs` carries both the trigger and the
                 duration: 0 is "nothing asked for", and the host sets it to 500/750/1000/1250/1500 to
                 fire an arrival of that length. Folding the two into one number is deliberate - it needs
                 one condition per transition, and it means the host cannot fire a reveal without also
                 saying how long it should take. -->
            <StateMachineLayer name="Reveal" id="0:91">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:112" />
                </EntryState>

                <AnimationState x="0" y="140" animationId="0:97" id="0:112">
                    <StateTransition stateToId="0:113" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:105" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="500" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:114" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:105" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="750" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:115" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:105" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1000" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:116" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:105" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1250" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:117" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:105" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1500" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:118" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:60-0:106" propertyKey="634" />
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <!-- speed = 500 / duration, because the timeline is authored at 500 ms. -->
                <AnimationState x="200" y="0" animationId="0:93" speed="1" id="0:113">
                    <StateTransition stateToId="0:112" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
                <AnimationState x="300" y="0" animationId="0:93" speed="0.6667" id="0:114">
                    <StateTransition stateToId="0:112" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
                <AnimationState x="400" y="0" animationId="0:93" speed="0.5" id="0:115">
                    <StateTransition stateToId="0:112" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
                <AnimationState x="500" y="0" animationId="0:93" speed="0.4" id="0:116">
                    <StateTransition stateToId="0:112" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
                <AnimationState x="600" y="0" animationId="0:93" speed="0.3333" id="0:117">
                    <StateTransition stateToId="0:112" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>

                <AnimationState x="0" y="280" animationId="0:104" id="0:118">
                    <StateTransition stateToId="0:112" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
            </StateMachineLayer>

            <!-- Layer 2 owns the airplane morph (FR-25): the Wi-Fi arcs collapse into the centre dot,
                 then the plane grows out of it. Blends independently of the reveal layer. -->
            <!-- MiddleSlot: the slot holds exactly one occupant, so this is a star rather than a mesh -
                 every morph leaves the Wi-Fi pose and returns to it. That is also why the arcs always
                 retract the same way before something new arrives: the slot has one way of emptying.

                 `middleMode` is a number (0 off, 1 Wi-Fi, 2 airplane, 3 DND) rather than one boolean per
                 occupant, because the slot can only hold one thing and a transition can compare a
                 number. The layer runs independently of Body, so a plane can already be showing while
                 the element is still arriving. -->
            <!-- MiddleSlot: the slot holds exactly one occupant, so this is a star rather than a mesh -
                 every morph leaves the Wi-Fi pose and returns to it. That is also why the arcs always
                 retract the same way before something new arrives: the slot has one way of emptying.

                 `middleMode` is a number (0 off, 1 Wi-Fi, 2 airplane, 3 DND) rather than one boolean per
                 occupant, because the slot can only hold one thing and a transition can compare a
                 number. The layer runs independently of Body, so a plane can already be showing while
                 the element is still arriving. -->
            <StateMachineLayer name="MiddleSlot" id="0:98">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:130" />
                </EntryState>

                <AnimationState x="0" y="140" animationId="0:121" id="0:130">
                    <StateTransition stateToId="0:101" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:107" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:128" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:107" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="3" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:131" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:107" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="0" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="0" y="280" animationId="0:120" id="0:131">
                    <StateTransition stateToId="0:130" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:107" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="200" y="0" animationId="0:102" id="0:101">
                    <StateTransition stateToId="0:132" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>

                <AnimationState x="300" y="0" animationId="0:122" id="0:132">
                    <StateTransition stateToId="0:133" duration="0">
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:107" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="300" y="140" animationId="0:124" id="0:133">
                    <StateTransition stateToId="0:130" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>

                <AnimationState x="400" y="0" animationId="0:125" id="0:128">
                    <StateTransition stateToId="0:134" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>

                <AnimationState x="500" y="0" animationId="0:123" id="0:134">
                    <StateTransition stateToId="0:135" duration="0">
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:60-0:107" propertyKey="636" />
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="3" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="500" y="140" animationId="0:126" id="0:135">
                    <StateTransition stateToId="0:130" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
            </StateMachineLayer>
            <!-- Charge: independent of Body and MiddleSlot, because charging is orthogonal to both - a
                 plane can be showing and the phone can be charging at once. -->
            <StateMachineLayer name="Charge" id="0:99">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:146" />
                </EntryState>

                <AnimationState x="0" y="140" animationId="0:140" id="0:146">
                    <StateTransition stateToId="0:147" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:60-0:108" propertyKey="634" />
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="200" y="0" animationId="0:142" id="0:147">
                    <StateTransition stateToId="0:148" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>

                <AnimationState x="300" y="0" animationId="0:141" id="0:148">
                    <!-- `notEqual true`, not `equal false`: that is the spelling the rest of this file
                         uses for a boolean's off case (see the airplane layer before it), and the
                         `equal false` form did not fire on the device. -->
                    <StateTransition stateToId="0:149" duration="0">
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:60-0:108" propertyKey="634" />
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="400" y="0" animationId="0:143" id="0:149">
                    <StateTransition stateToId="0:146" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
            </StateMachineLayer>
            <!-- WifiLevel: one continuous axis, so it cross-fades for free and needs no state per level.
                 A blend state has NO outgoing transition on purpose - leaving the layer would stop it
                 advancing, and a machine that stops advancing stops drawing. -->
            <StateMachineLayer name="WifiLevel" id="0:164">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:165" />
                </EntryState>
                <BlendState1DViewModel x="200" y="0" id="0:165">
                    <BindablePropertyNumber>
                        <DataBindContext sourcePathIds="0:60-0:150" propertyKey="636" />
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="0:155" value="0" />
                    <BlendAnimation1D animationId="0:156" value="1" />
                    <BlendAnimation1D animationId="0:157" value="2" />
                    <BlendAnimation1D animationId="0:158" value="3" />
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- CellLevel: one continuous axis, so it cross-fades for free and needs no state per level.
                 A blend state has NO outgoing transition on purpose - leaving the layer would stop it
                 advancing, and a machine that stops advancing stops drawing. -->
            <StateMachineLayer name="CellLevel" id="0:166">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:167" />
                </EntryState>
                <BlendState1DViewModel x="200" y="0" id="0:167">
                    <BindablePropertyNumber>
                        <DataBindContext sourcePathIds="0:60-0:151" propertyKey="636" />
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="0:159" value="0" />
                    <BlendAnimation1D animationId="0:160" value="1" />
                    <BlendAnimation1D animationId="0:161" value="2" />
                    <BlendAnimation1D animationId="0:162" value="3" />
                    <BlendAnimation1D animationId="0:163" value="4" />
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>

        <!-- ============================== entrance ==============================
             One shot, 240 frames = **4 s** (user feedback: 4x slower than the 1 s cut). The element
             grows out of a point, overshoots, and springs back, with a small rotational settle and a
             quick fade - the "arrive" moment. Three properties move together (scale, rotation,
             opacity), all on the one group node, so the whole body moves as a unit (FR-25: synced).

             Timing (frames @ 60 fps):
                 scale   0 -> 1.25 (72) -> 0.92 (128) -> 1.06 (176) -> 1.0 (240)  overshoot + spring
                 rotation -25 deg -> +6 deg (128) -> 0 (240)                     settle from a tilt
                 opacity 0 -> 1 (48), hold                                        the point becomes a body

             Keys live on the group node (0:3) only: scaleX 16, scaleY 17, rotation 15, opacity 18.
             Those four are owned by this layer and Idle - no other layer or data bind touches them,
             so animation and binding never fight (the same rule the airplane morph follows). -->
        <LinearAnimation duration="30" name="Reveal" id="0:93">
            <KeyedObject objectId="0:3">
                <!-- The arrival. Authored at the SHORTEST duration (30 frames = 500 ms); the longer
                     variants are the same timeline played slower by `AnimationState.speed`, so there is
                     one shape to tune rather than five. Every ease is a nested interpolator, not just the
                     word `cubic`: per `rive docs gotchas`, a cubic keyframe with no CubicEaseInterpolator
                     child does not ease at all. The curve on a keyframe governs the segment that STARTS
                     at it; the last keyframe's is never read.

                     Shape, and why:
                       0.75 -> 1.10  (0-100 ms)  decelerate into a 10% overshoot - the arrival "pop"
                       1.10 -> 0.97  (100-200 ms) the rebound
                       0.97 -> 1.00  (200-500 ms) one damped elastic settle, ~2 visible bounces
                     It starts at 0.75, not 0: at 140 px a zero-point spawn reads as a bubble, not as
                     the element arriving. And not at 1.0, because an arrival needs somewhere to arrive
                     from. -->
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.75" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.1" interpolationType="cubic" frame="6">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.97" interpolationType="elastic" frame="12">
                        <ElasticInterpolator easingValue="easeOut" amplitude="0.35" period="0.4" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="30" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.75" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.1" interpolationType="cubic" frame="6">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.97" interpolationType="elastic" frame="12">
                        <ElasticInterpolator easingValue="easeOut" amplitude="0.35" period="0.4" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="30" />
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <!-- The tilt resolves AFTER the pop (peak at 267 ms, scale peaks at 100 ms): the
                         body arrives, then settles square. -->
                    <KeyFrameDouble value="-0.4363" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.1047" interpolationType="cubic" frame="16">
                        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" interpolationType="hold" frame="30" />
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <!-- Fully opaque at 100 ms, before the body has finished settling: the element is
                         legible first and beautiful second, which is the only order that works on a
                         status bar. -->
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="6" />
                    <KeyFrameDouble value="1" interpolationType="hold" frame="30" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- The departure. Ease-in, so it reads as *pulled away* rather than *placed* - the inverse of
             the arrival's ease-out. 40% shorter than the shortest arrival: leaving should not hold you.
             The tilt goes the other way so a quick lock->unlock does not replay the same arc and read as
             a stutter. No overshoot: shrinking past the target before vanishing looks like a glitch. -->
        <LinearAnimation duration="27" name="Depart" id="0:104">
            <KeyedObject objectId="0:3">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0.64" y1="0" x2="0.78" y2="0" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.94" interpolationType="hold" frame="27" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0.64" y1="0" x2="0.78" y2="0" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.94" interpolationType="hold" frame="27" />
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0.64" y1="0" x2="0.78" y2="0" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.1047" interpolationType="hold" frame="27" />
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="0">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1" />
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" interpolationType="hold" frame="27" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Idle: pins the group at scale 1 so the reveal can be re-fired from a known state. -->
        <!-- `loop` on the idle states is load-bearing, not decoration: a state machine only keeps
             advancing while it has a playing animation, and the renderer only draws while the machine
             advances. With the default `oneShot` these 1-frame holds finished immediately, the machine
             went idle, the loop stopped, and every later data bind was written but never drawn. -->
        <LinearAnimation duration="1" name="Idle" id="0:97" loopValue="loop">
            <KeyedObject objectId="0:3">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <!-- Pinned back to rest too, so the entrance can re-fire from a known state. -->
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Wi-Fi idle: arcs at their resting trim, plane scaled to nothing. -->
        <LinearAnimation duration="1" name="WifiPose0" id="0:155" loopValue="loop">
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:15">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="WifiPose1" id="0:156" loopValue="loop">
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:15">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="WifiPose2" id="0:157" loopValue="loop">
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:15">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="WifiPose3" id="0:158" loopValue="loop">
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:15">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="CellPose0" id="0:159" loopValue="loop">
            <KeyedObject objectId="0:17">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:18">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:19">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="CellPose1" id="0:160" loopValue="loop">
            <KeyedObject objectId="0:17">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:18">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:19">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.3" interpolationType="hold" frame="0" />
                </KeyedProperty>
