            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- ============================ the charge ============================
             Plugging in tells a story rather than flipping a flag: the Wi-Fi leaves where it sits, the
             bolt appears IN the middle slot - the same place, so the eye never has to search - and then
             rises to its real home in the ring's top gap, shrinking as it goes, while the Wi-Fi comes
             back behind it. The bolt is born where the Wi-Fi was.

             The Wi-Fi's own opacity is untouched: the fade lives on the group node, so it multiplies
             with the arcs' bound signal level and the dot's slot opacity instead of fighting either. -->

        <LinearAnimation duration="1" name="ChargeDigits" id="0:140" loopValue="loop">
            <KeyedObject objectId="0:30">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:50">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="-49.5" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:136">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="ChargeBolt" id="0:141" loopValue="loop">
            <KeyedObject objectId="0:30">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:50">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="-49.5" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:136">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
