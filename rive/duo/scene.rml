<?xml version="1.0" encoding="utf-8"?>
<!--
  DUO STATUS BAR — the status-bar element, authored in the design space of docs/DESIGN-duo.md.

  Calibrated facts about Rive's parametric paths (measured, not guessed — see rive/_calib):
    * TrimPath fractions run clockwise from 12 o'clock: fraction f == f * 360 degrees.
    * A trim wraps when start > end (0.75 -> 0.10 draws across the top).
    * `offset` rotates the trimmed window; start=0 end=0.3222 offset=0.8389 centres it on top.
    * Stroke effects (TrimPath) nest INSIDE the Stroke, not beside the path.

  Design coordinates live in a 120x120 box with the ring centred at (59.5, 61.5). Everything is
  parented to one Node placed at that centre, so children are written relative to it and the whole
  element can be scaled as a body (the reveal animation scales this Node).
-->
<Rive version="1" kind="fragment">
    <Artboard width="120" height="120" name="Duo" id="0:2" viewModelId="0:60" viewModelInstanceId="0:61" defaultStateMachineId="0:90">

        <Node x="60" y="61.5" name="duoGroup" id="0:3">

            <!-- ====================== battery percentage text ======================
                 Sits inside the ring's top gap (the gap is 71.3deg wide). Text type keys:
                 alignValue 281 (center), originX 366 / originY 367 (normalized),
                 TextStylePaint.fontSize 274, .fontAssetId 279.                            -->

            <Text x="-3.5" y="-60" width="80" height="42" alignValue="center" originX="0.5" originY="0"
                sizingValue="fixed" overflowValue="visible" name="percent" id="0:30">
                <TextStylePaint fontSize="42" fontAssetId="0:40" name="PercentStyle" id="0:31">
                    <DataBindContext propertyKey="274" sourcePathIds="0:60-0:84" />
                    <Fill name="Fill">
                        <SolidColor colorValue="FFFFFFFF" name="Color">
                            <DataBindContext propertyKey="37" sourcePathIds="0:60-0:82" />
                        </SolidColor>
                    </Fill>
                    <!-- Weight: the reference digits are heavy and rounded. Stroking the glyphs fatten
                         them with any font, so the look survives the font swap in Phase 5. -->
                    <Stroke thickness="2.4" cap="round" join="round" name="Weight">
                        <SolidColor colorValue="FFFFFFFF" name="Color">
                            <DataBindContext propertyKey="37" sourcePathIds="0:60-0:82" />
                        </SolidColor>
                    </Stroke>
                </TextStylePaint>
                <TextValueRun styleId="0:31" text="50" name="Run">
                    <DataBindContext propertyKey="268" sourcePathIds="0:60-0:83" />
                </TextValueRun>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:65" />
            </Text>

            <!-- ============================ battery ring ============================
                 Ring r 51.5 (Ellipse 103x103), stroke 8, round caps.
                 Drawn arc 238.7deg -> 121.3deg clockwise, split by the top gap that holds the
                 percentage.  Top gap edges: 324.35deg (0.9010) and 35.65deg (0.0990).
                 Left segment  = 0.6631 -> 0.9010   (fill 0% .. 50%)
                 Right segment = 0.0990 -> 0.3369   (fill 50% .. 100%)                     -->

            <Shape opacity="0.22" name="ringTrackL" id="0:10">
                <Ellipse width="103" height="103" originX="0.5" originY="0.5" name="Path" />
                <Stroke thickness="8" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="Track" />
                    <TrimPath start="0.6631" end="0.9010" offset="0" name="Trim">
                        <DataBindContext propertyKey="115" sourcePathIds="0:60-0:88" />
                    </TrimPath>
                </Stroke>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:64" />
            </Shape>

            <Shape opacity="0.22" name="ringTrackR" id="0:11">
                <Ellipse width="103" height="103" originX="0.5" originY="0.5" name="Path" />
                <Stroke thickness="8" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="Track" />
                    <TrimPath start="0.0990" end="0.3369" offset="0" name="Trim">
                        <DataBindContext propertyKey="114" sourcePathIds="0:60-0:89" />
                    </TrimPath>
                </Stroke>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:64" />
            </Shape>

            <!-- battery fill, left half: 0 .. 50%. The app computes the trim end from the level
                 (trim = 0.6631 + min(level,50)/50 * 0.2379) so no arithmetic is needed in Rive. -->
            <Shape name="ringFillL" id="0:12">
                <Ellipse width="103" height="103" originX="0.5" originY="0.5" name="Path" />
                <Stroke thickness="8" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="Color">
                        <DataBindContext propertyKey="37" sourcePathIds="0:60-0:81" />
                    </SolidColor>
                    <TrimPath start="0.6631" end="0.9010" offset="0" name="Trim">
                        <DataBindContext propertyKey="115" sourcePathIds="0:60-0:62" />
                    </TrimPath>
                </Stroke>
            </Shape>

            <!-- battery fill, right half: 50 .. 100% (trim = 0.0990 + max(level-50,0)/50 * 0.2379) -->
            <Shape name="ringFillR" id="0:13">
                <Ellipse width="103" height="103" originX="0.5" originY="0.5" name="Path" />
                <Stroke thickness="8" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="Color">
                        <DataBindContext propertyKey="37" sourcePathIds="0:60-0:81" />
                    </SolidColor>
                    <TrimPath start="0.0990" end="0.0990" offset="0" name="Trim">
                        <!-- start follows the top gap's right edge, so the ring closes when the number is
                             hidden and narrows for the bolt while charging (FR-25 / DESIGN §4). -->
                        <DataBindContext propertyKey="114" sourcePathIds="0:60-0:89" />
                        <DataBindContext propertyKey="115" sourcePathIds="0:60-0:63" />
                    </TrimPath>
                </Stroke>
            </Shape>

            <!-- ============================== Wi-Fi ==============================
                 centre (59.5, 78.5) -> (-0.5, 17) relative to the group node.
                 Each layer is an arc spanning +/-58deg centred on 12 o'clock:
                 end = 116/360 = 0.3222, offset = 302/360 = 0.8389.
                 Layer 1 and 2 are arcs; the third element is the solid dot.            -->

            <Shape name="wifiLayer1" id="0:14">
                <Ellipse x="-0.5" y="17" width="62" height="62" originX="0.5" originY="0.5" name="Path" />
                <Stroke thickness="7" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="Color" />
                    <TrimPath start="0" end="0.3222" offset="0.8389" name="Trim" id="0:110" />
                </Stroke>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:67" />
            </Shape>

            <Shape name="wifiLayer2" id="0:15">
                <Ellipse x="-0.5" y="17" width="37" height="37" originX="0.5" originY="0.5" name="Path" />
                <Stroke thickness="7" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FFFFFFFF" name="Color" />
                    <TrimPath start="0" end="0.3222" offset="0.8389" name="Trim" id="0:111" />
                </Stroke>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:68" />
            </Shape>

            <Shape name="wifiDot" id="0:16">
                <Ellipse x="-0.5" y="13.5" width="14" height="12" originX="0.5" originY="0.5" name="Path" />
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:69" />
            </Shape>

            <!-- ============================ charging bolt ============================
                 Appears in the ring's top gap instead of the digits; the gap narrows to 55.6deg.
                 PointsPath vertices are in the shape's local space, so this bolt is authored around
                 (0,0) and the Shape is placed where the gap's centre is.                        -->

            <Shape x="0" y="-49.5" opacity="0" name="bolt" id="0:50">
                <PointsPath isClosed="true" name="Path">
                    <StraightVertex x="3.5" y="-10" radius="1.4" />
                    <StraightVertex x="-7.5" y="0.5" radius="1.4" />
                    <StraightVertex x="-1.5" y="0.5" radius="1.4" />
                    <StraightVertex x="-3.5" y="10" radius="1.4" />
                    <StraightVertex x="7.5" y="-0.5" radius="1.4" />
                    <StraightVertex x="1.5" y="-0.5" radius="1.4" />
                </PointsPath>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:66" />
            </Shape>

            <!-- ============================== airplane ==============================
                 Occupies the Wi-Fi slot when airplane mode is on: the Wi-Fi layers collapse into
                 the dot, then this scales up from inside it (FR-25).                              -->

            <Shape x="-0.5" y="13.5" opacity="0" name="airplane" id="0:51">
                <PointsPath isClosed="true" name="Path">
                    <StraightVertex x="0" y="-8" radius="0.8" />
                    <StraightVertex x="1.6" y="-2.2" radius="0.8" />
                    <StraightVertex x="8" y="2.2" radius="0.8" />
                    <StraightVertex x="8" y="4.2" radius="0.8" />
                    <StraightVertex x="1.6" y="2.6" radius="0.8" />
                    <StraightVertex x="1.2" y="6.5" radius="0.8" />
                    <StraightVertex x="3.5" y="8.5" radius="0.8" />
                    <StraightVertex x="-3.5" y="8.5" radius="0.8" />
                    <StraightVertex x="-1.2" y="6.5" radius="0.8" />
                    <StraightVertex x="-1.6" y="2.6" radius="0.8" />
                    <StraightVertex x="-8" y="4.2" radius="0.8" />
                    <StraightVertex x="-8" y="2.2" radius="0.8" />
                    <StraightVertex x="-1.6" y="-2.2" radius="0.8" />
                </PointsPath>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:75" />
            </Shape>

            <!-- =============================== DND moon ===============================
                 The middle slot's second occupant (FR-06): while Do Not Disturb is on, the Wi-Fi
                 fades out and this crescent fades in. The path is NOT drawn by hand - it is the
                 real `drawable/stat_sys_dnd` from the target device's SystemUI, read with
                 `aapt2 dump xmltree` and converted to Rive cubic handles by
                 tools/dnd-moon-to-rive.py, which resamples the result against the source cubics
                 and refuses to emit a mismatch. The shape sits at the Wi-Fi centre (-0.5, 17) and
                 is scaled to the slot. -->

            <Shape x="-0.5" y="17" opacity="0" name="dndMoon" id="0:52">
                <PointsPath isClosed="true" name="Path" id="0:53">
                    <CubicDetachedVertex x="-1.839" y="-16.341" inRotation="0.000000" inDistance="0.000" outRotation="-0.982794" outDistance="0.541" />
                    <CubicDetachedVertex x="-1.809" y="-17.841" inRotation="1.012197" inDistance="0.566" outRotation="-2.158799" outDistance="0.541" />
                    <CubicDetachedVertex x="-3.189" y="-18.441" inRotation="-0.165149" inDistance="0.547" outRotation="2.963567" outDistance="8.809" />
                    <CubicDetachedVertex x="-18.459" y="-0.141" inRotation="-1.570796" inDistance="9.150" outRotation="1.570796" outDistance="10.260" />
                    <CubicDetachedVertex x="0.141" y="18.459" inRotation="3.141593" inDistance="10.260" outRotation="0.000000" outDistance="9.150" />
                    <CubicDetachedVertex x="18.441" y="3.159" inRotation="1.748221" inDistance="8.839" outRotation="-1.396124" outDistance="0.518" />
                    <CubicDetachedVertex x="17.841" y="1.809" inRotation="0.540420" inDistance="0.525" outRotation="-2.582993" outDistance="0.566" />
                    <CubicDetachedVertex x="16.341" y="1.839" inRotation="-0.632749" inDistance="0.558" outRotation="2.518684" outDistance="2.623" />
                    <CubicDetachedVertex x="8.751" y="4.239" inRotation="0.000000" inDistance="2.850" outRotation="3.141593" outDistance="7.200" />
                    <CubicDetachedVertex x="-4.269" y="-8.781" inRotation="1.570796" inDistance="7.200" outRotation="-1.570796" outDistance="2.820" />
                    <CubicDetachedVertex x="-1.869" y="-16.341" inRotation="2.177784" inDistance="2.630" outRotation="0.000000" outDistance="0.000" />
                </PointsPath>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:87" />
            </Shape>

            <!-- ========================== cellular spheres ==========================
                 r 5.5, on a downward arc concentric with the ring.                     -->

            <Shape name="cell1" id="0:17">
                <Ellipse x="-27" y="42.7" width="11" height="11" originX="0.5" originY="0.5" name="Path" />
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:71" />
            </Shape>
            <Shape name="cell2" id="0:18">
                <Ellipse x="-9.5" y="49.7" width="11" height="11" originX="0.5" originY="0.5" name="Path" />
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:72" />
            </Shape>
            <Shape name="cell3" id="0:19">
                <Ellipse x="8.5" y="50.2" width="11" height="11" originX="0.5" originY="0.5" name="Path" />
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:73" />
            </Shape>
            <Shape name="cell4" id="0:20">
                <Ellipse x="26" y="44.3" width="11" height="11" originX="0.5" originY="0.5" name="Path" />
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" /></Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:60-0:74" />
            </Shape>
        </Node>

        <!-- =========================== state machine ===========================
             Inside the artboard, not beside it: an artboard only runs a machine declared as its
             child, and data binds only apply while a machine is running. The Reveal animation owns
             exactly the properties that are NOT bound (the group's scale), so animation and data
             binding never fight over the same value.                                    -->

        <StateMachine name="Duo" id="0:90">
            <!-- Inputs are view model booleans rather than StateMachineBool/Trigger on purpose: the
                 runtime's state-machine input setters are Kotlin `internal` (only
                 `SMIBoolean.setValue$kotlin_release` exists), so a host application cannot drive
                 them. Drawn from the view model, every input is reachable through the public
                 ViewModelInstance API. -->

            <!-- Layer 1 owns the reveal: scale bounce, one shot, re-fired through `revealRequest`.
                 Opacity and colour are deliberately NOT keyed here — they belong to the data binds,
                 so the two mechanisms never fight over the same property. -->
            <StateMachineLayer name="Reveal" id="0:91">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:92" />
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:93" id="0:92">
                    <StateTransition stateToId="0:96" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
                </AnimationState>
                <AnimationState x="0" y="140" animationId="0:97" id="0:96">
                    <StateTransition stateToId="0:92" duration="0">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:60-0:86" propertyKey="634" />
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Layer 2 owns the airplane morph (FR-25): the Wi-Fi arcs collapse into the centre dot,
                 then the plane grows out of it. Blends independently of the reveal layer. -->
            <StateMachineLayer name="Airplane" id="0:98">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:99" />
                </EntryState>
                <AnimationState x="0" y="140" animationId="0:100" id="0:99">
                    <StateTransition stateToId="0:101" duration="80">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:60-0:85" propertyKey="634" />
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="200" y="0" animationId="0:102" id="0:101">
                    <StateTransition stateToId="0:99" duration="80">
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:60-0:85" propertyKey="634" />
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true" />
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- ============================== entrance ==============================
             One shot, 60 frames = 1 s. The element grows out of a point, overshoots, and springs
             back, with a small rotational settle and a quick fade - the "arrive" moment. Three
             properties move together (scale, rotation, opacity), all on the one group node, so the
             whole body moves as a unit (FR-25: synced parts).

             Timing (frames @ 60 fps):
                 scale   0 -> 1.25 (18) -> 0.92 (32) -> 1.06 (44) -> 1.0 (60)   overshoot + spring
                 rotation -25 deg -> +6 deg (32) -> 0 (60)                      settle from a tilt
                 opacity 0 -> 1 (12), hold                                       the point becomes a body

             Keys live on the group node (0:3) only: scaleX 16, scaleY 17, rotation 15, opacity 18.
             Those four are owned by this layer and Idle - no other layer or data bind touches them,
             so animation and binding never fight (the same rule the airplane morph follows). -->
        <LinearAnimation duration="60" name="Reveal" id="0:93">
            <KeyedObject objectId="0:3">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="1.25" interpolationType="cubic" frame="18" />
                    <KeyFrameDouble value="0.92" interpolationType="cubic" frame="32" />
                    <KeyFrameDouble value="1.06" interpolationType="cubic" frame="44" />
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="60" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="1.25" interpolationType="cubic" frame="18" />
                    <KeyFrameDouble value="0.92" interpolationType="cubic" frame="32" />
                    <KeyFrameDouble value="1.06" interpolationType="cubic" frame="44" />
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="60" />
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0.4363" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="0.1047" interpolationType="cubic" frame="32" />
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="60" />
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="12" />
                    <KeyFrameDouble value="1" interpolationType="hold" frame="60" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Idle: pins the group at scale 1 so the reveal can be re-fired from a known state. -->
        <!-- `loop` on the idle states is load-bearing, not decoration: a state machine only keeps
             advancing while it has a playing animation, and the renderer only draws while the machine
             advances. With the default `oneShot` these 1-frame holds finished immediately, the machine
             went idle, the loop stopped, and every later data bind was written but never drawn. -->
        <LinearAnimation duration="1" name="Idle" id="0:97" loopValue="loop">
            <KeyedObject objectId="0:3">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <!-- Pinned back to rest too, so the entrance can re-fire from a known state. -->
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Wi-Fi idle: arcs at their resting trim, plane scaled to nothing. -->
        <LinearAnimation duration="1" name="WifiIdle" id="0:100" loopValue="loop">
            <KeyedObject objectId="0:110">
                <KeyedProperty propertyKey="115">
                    <KeyFrameDouble value="0.3222" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="116">
                    <KeyFrameDouble value="0.8389" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:111">
                <KeyedProperty propertyKey="115">
                    <KeyFrameDouble value="0.3222" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="116">
                    <KeyFrameDouble value="0.8389" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:51">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0" interpolationType="hold" frame="0" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Airplane morph: 12 frames = 200 ms. Each arc slides to 6 o'clock (fraction 0.5, the dot's
             position) while its length shrinks to zero, then the plane scales up out of that same
             point over the last 11 frames. -->
        <LinearAnimation duration="12" name="PlaneMorph" id="0:102">
            <KeyedObject objectId="0:110">
                <KeyedProperty propertyKey="115">
                    <KeyFrameDouble value="0.3222" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="7" />
                </KeyedProperty>
                <KeyedProperty propertyKey="116">
                    <KeyFrameDouble value="0.8389" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="0.5" interpolationType="cubic" frame="7" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:111">
                <KeyedProperty propertyKey="115">
                    <KeyFrameDouble value="0.3222" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="7" />
                </KeyedProperty>
                <KeyedProperty propertyKey="116">
                    <KeyFrameDouble value="0.8389" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="0.5" interpolationType="cubic" frame="7" />
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:51">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="11" />
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="0" />
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="11" />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- Font for the digits. Montserrat (OFL) ships with the Rive CLI samples; the final build will
         bundle a rounded face so the numbers match Apple's, with a "use system font" option. -->
    <FontAsset file="Montserrat.ttf" name="Montserrat" id="0:40" />

    <!-- ============================== data model ==============================
         The host application (inside SystemUI) sets these; the binds above push them into the
         drawing. All geometry maths lives in Kotlin so it can be unit-tested, which is why the
         ring exposes ready-made trim ends instead of a battery percentage.               -->

    <ViewModel defaultInstanceId="0:61" name="DuoModel" id="0:60">
        <ViewModelPropertyNumber name="trimLeftEnd" id="0:62" />
        <ViewModelPropertyNumber name="trimRightEnd" id="0:63" />
        <ViewModelPropertyNumber name="trackOpacity" id="0:64" />
        <ViewModelPropertyNumber name="percentOpacity" id="0:65" />
        <ViewModelPropertyNumber name="boltOpacity" id="0:66" />
        <ViewModelPropertyNumber name="wifiOuterOpacity" id="0:67" />
        <ViewModelPropertyNumber name="wifiMidOpacity" id="0:68" />
