<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 27 STATUS BAR — the three glyphs, authored in the design space of
  app/src/main/java/io/github/kvmy666/duostatusbar/hook/IosGeometry.kt.

  Design unit: the battery body height is exactly 100, so every number here is the
  same number that Kotlin and IosCanvasView use.  The artboards are split because the
  host skins each stock icon in its own slot:

    Ios        battery  209.2 x 102
    IosWifi    Wi-Fi    129.53 x 96.77
    IosCell    cellular 150.1 x 105.6

  All three share ONE view model, IosModel (id 0:1000), so the 12 properties named in
  docs/ios-rive-contract.md are declared once and every artboard binds the same values.
  Each artboard has a state machine named `Ios`.

  Rive paints front-to-back: the FIRST sibling paints on top.  The battery therefore
  declares bolt, cap, fill, remainder, clip source in that top-to-bottom order.

  Battery fill technique:
    A DataConverterRangeMapper (0:1014) maps batteryLevel 0..1 to the fill Rectangle's
    width 0..189.3.  The fill Shape itself is never scaled, and a ClippingShape masks
    it against a paintless rounded-rect body (0:1102).  The left rounded corners are
    therefore the body's, and the split is the Rectangle's straight right edge.  All
    four fill-rectangle corner radii are 0 so the Rectangle cannot round the split;
    the body clip owns both rounded ends.
    The alternative — bind Node.scaleX to batteryLevel and clip a full-width fill —
    scales the mask as well as the artwork, so the left corner radius may distort.
    Chosen from the schema; the converter-vs-scaleX pixel A/B is UNVERIFIED.
-->
<Rive version="1" kind="fragment">

    <!-- ============================================================ BATTERY -->
    <Artboard x="0" y="0" width="209.2" height="102" name="Ios" id="0:1100"
              viewModelId="0:1000" viewModelInstanceId="0:1013" defaultStateMachineId="0:1120">
        <Node name="batteryRoot" id="0:1101">

            <!-- Bolt: the R9 no-digit mode is a SOLID system-ink 67 x 92 bolt centred on the
                 body (IosDigits.BOLT_NORMALIZED scaled to LARGE_BOLT_W/H), with NO outline.
                 The Shape opacity is still the only property driven by boltOpacity, so the host
                 can fade the whole glyph. The 40 x 59 inline variant (digits present) is a
                 knockout shape; it is authored in the IosDigits artboard sample. -->
            <Shape name="bolt" id="0:1107">
                <PointsPath isClosed="true" name="Path">
                    <StraightVertex x="109.9411" y="5" />
                    <StraightVertex x="109.9411" y="13.97" />
                    <StraightVertex x="100.1189" y="32.6736" />
                    <StraightVertex x="98.33" y="40.4752" />
                    <StraightVertex x="99.2211" y="43.594" />
                    <StraightVertex x="102.7989" y="45.9308" />
                    <StraightVertex x="127.81" y="45.1488" />
                    <StraightVertex x="128.7011" y="47.4948" />
                    <StraightVertex x="127.81" y="49.8316" />
                    <StraightVertex x="106.37" y="70.0992" />
                    <StraightVertex x="92.0789" y="87.2572" />
                    <StraightVertex x="81.3589" y="96.6136" />
                    <StraightVertex x="81.3589" y="88.812" />
                    <StraightVertex x="91.1811" y="69.3264" />
                    <StraightVertex x="92.97" y="61.5248" />
                    <StraightVertex x="89.3989" y="57.624" />
                    <StraightVertex x="64.3811" y="57.624" />
                    <StraightVertex x="62.5989" y="55.2872" />
                    <StraightVertex x="74.21" y="41.2572" />
                    <StraightVertex x="80.4611" y="36.5744" />
                    <StraightVertex x="92.97" y="21.7624" />
                </PointsPath>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFFFFF" name="Color">
                        <DataBindContext propertyKey="37" sourcePathIds="0:1000-0:1003" />
                    </SolidColor>
                </Fill>
                <DataBindContext propertyKey="18" sourcePathIds="0:1000-0:1007" />
            </Shape>

            <!-- Nub: the R9 separate half-capsule (flat left at CAP_LEFT 193.9, round right),
                 14.3 x 32.1, top 34.95, 3.6 units after the body. The 25-gon repeats
                 IosGeometry.Battery.CAP_POINTS in absolute artboard coordinates. It is the
                 neutral tint (0:1003) at shape opacity 0.50, the same ink as the remainder. -->
            <Shape name="cap" id="0:1106" opacity="0.50">
                <PointsPath isClosed="true" name="Path">
                    <StraightVertex x="193.9" y="34.95" />
                    <StraightVertex x="195.7665" y="35.0873" />
                    <StraightVertex x="197.6011" y="35.4969" />
                    <StraightVertex x="199.3724" y="36.1717" />
                    <StraightVertex x="201.05" y="37.1003" />
                    <StraightVertex x="202.6053" y="38.2667" />
                    <StraightVertex x="204.0116" y="39.6509" />
                    <StraightVertex x="205.245" y="41.2294" />
                    <StraightVertex x="206.2842" y="42.975" />
                    <StraightVertex x="207.1115" y="44.8579" />
                    <StraightVertex x="207.7127" y="46.846" />
                    <StraightVertex x="208.0777" y="48.9051" />
                    <StraightVertex x="208.2" y="51" />
                    <StraightVertex x="208.0777" y="53.0949" />
                    <StraightVertex x="207.7127" y="55.154" />
                    <StraightVertex x="207.1115" y="57.1421" />
                    <StraightVertex x="206.2842" y="59.025" />
                    <StraightVertex x="205.245" y="60.7706" />
                    <StraightVertex x="204.0116" y="62.3491" />
                    <StraightVertex x="202.6053" y="63.7333" />
                    <StraightVertex x="201.05" y="64.8997" />
                    <StraightVertex x="199.3724" y="65.8283" />
                    <StraightVertex x="197.6011" y="66.5031" />
                    <StraightVertex x="195.7665" y="66.9127" />
                    <StraightVertex x="193.9" y="67.05" />
                </PointsPath>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFFFFF" name="Color">
                        <DataBindContext propertyKey="37" sourcePathIds="0:1000-0:1003" />
                    </SolidColor>
                </Fill>
            </Shape>

            <!-- Charged fill: a full-height Rectangle whose width is the level, clipped by the
                 189.3 x 100 body. Rectangle width is ParametricPath key 20; the converter turns
                 the view model's 0..1 into design units. Authored width 189.3 is the pre-data
                 pose (full charge), never 0, so a missing bind cannot look like an empty
                 battery. -->
            <Shape x="1" y="1" name="batteryFill" id="0:1104">
                <!-- The clip supplies the body's rounded left/right edges; the Rectangle
                     itself must stay square so the level split is a straight vertical edge. -->
                <Rectangle width="189.3" height="100" originX="0" originY="0"
                           cornerRadiusTL="0" cornerRadiusTR="0"
                           cornerRadiusBL="0" cornerRadiusBR="0" name="Path" id="0:1105">
                    <DataBindContext propertyKey="20" sourcePathIds="0:1000-0:1004"
                                     converterId="0:1014" />
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFFFFF" name="Color">
                        <DataBindContext propertyKey="37" sourcePathIds="0:1000-0:1006" />
                    </SolidColor>
                </Fill>
                <ClippingShape sourceId="0:1102" name="Clip" />
            </Shape>

            <!-- Uncharged remainder: the same 189.3 x 100 body shape in the neutral tint (0:1003)
                 at shape opacity 0.50 (the light-ink R9 remainder alpha); the runtime picks
                 0.30 for dark ink. Shape opacity is 18. -->
            <Shape x="1" y="1" opacity="0.50" name="batteryRemainder" id="0:1103">
                <Rectangle width="189.3" height="100" originX="0" originY="0"
                           cornerRadiusTL="28.6" name="Path" />
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFFFFF" name="Color">
                        <DataBindContext propertyKey="37" sourcePathIds="0:1000-0:1003" />
                    </SolidColor>
                </Fill>
            </Shape>

            <!-- Clip source: the same rounded body with no paints.  A hidden shape would
                 export an empty mask, so this stays shown and simply draws nothing. -->
            <Shape x="1" y="1" name="bodyClip" id="0:1102">
                <Rectangle width="189.3" height="100" originX="0" originY="0"
                           cornerRadiusTL="28.6" name="Path" />
            </Shape>

        </Node>

        <StateMachine name="Ios" id="0:1120">
            <StateMachineLayer name="Visibility" id="0:1121">
                <AnyState x="200" y="-120" />
                <ExitState x="400" y="-120" />
                <EntryState>
                    <StateTransition stateToId="0:1122" />
